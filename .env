### Documentation available at https://wodby.com/docs/1.0/stacks/python/local
### Changelog can be found at https://github.com/wodby/docker4python/releases
### Images tags format explained at https://github.com/wodby/docker4python#images-tags

### PROJECT SETTINGS

PROJECT_NAME=my_python_project
PROJECT_BASE_URL=python.docker.localhost

DB_NAME=python
DB_USER=python
DB_PASSWORD=python
DB_HOST=postgres
DB_ADAPTER=postgresql
DB_ENGINE=django.db.backends.postgresql
#DB_ENGINE=django.db.backends.mysql

### --- PYTHON ----

# Linux (uid 1000 gid 1000)

PYTHON_TAG=3.14-dev-r7
#PYTHON_TAG=3.13-dev-r7
#PYTHON_TAG=3.12-dev-r7
#PYTHON_TAG=3.11-dev-r7

# macOS (uid 501 gid 20)

#PYTHON_TAG=3.14-dev-macos-r7
#PYTHON_TAG=3.13-dev-macos-r7
#PYTHON_TAG=3.12-dev-macos-r7
#PYTHON_TAG=3.11-dev-macos-r7

